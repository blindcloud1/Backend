# ============================================================
#  BlindsCloud Backend — environment configuration
#  Copy to `.env` and fill in real values.
#  `.env` is git-ignored. NEVER commit real secrets.
# ============================================================

# ---------- Secrets (REQUIRED) ----------
# Every service throws "JWT_SECRET is required" at startup if this is missing.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Database ----------
# Credentials for the MongoDB container created by docker-compose.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me

# Credentials for the RabbitMQ container created by docker-compose.
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change-me

# Connection strings.
#
# These point at `localhost` because they are used by services running on the HOST
# (`npm run dev`). The docker-compose services always use the in-network hostnames
# (`mongo:27017` / `rabbitmq:5672`) — see docker-compose.yml.
#
# The dev compose file publishes mongo 27017 and rabbitmq 5672 to 127.0.0.1 so both
# modes can reach the same containers.
MONGO_URL=mongodb://admin:change-me@localhost:27017/admin
RABBITMQ_URL=amqp://admin:change-me@localhost:5672

# ---------- Gateway ----------
# Where the frontend talks to. Used for password-reset / verification links.
FRONTEND_URL=http://localhost:5180

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5180,http://localhost:5173

# ---------- Events ----------
EVENT_EXCHANGE=blindscloud.events

# ---------- Seeding ----------
# When true and the `users` collection is empty, auth-service inserts
# admin@blindscloud.co.uk / password. NEVER enable this in production.
SEED_DEMO=true

# ---------- Email (SendGrid) ----------
# Leave blank locally — email sending is skipped, everything else still works.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=support@blindscloud.co.uk
SENDGRID_FROM_NAME=BlindsCloud

# ---------- Payments (Stripe) ----------
# Leave blank locally — the billing service disables itself without a key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- AI pricing-table extraction (OpenAI GPT-4o vision) ----------
# Used by the product page -> 'Use AI to extract prices'.
# Server-side only. Never expose this to the browser.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_VISION_DETAIL=high

# ---------- Files ----------
UPLOAD_DIR=./uploads
FILES_BASE_URL=http://localhost:3001/api
